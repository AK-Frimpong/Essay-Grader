# ─── Google Cloud Vision OCR (handwritten essay recognition) ───
# Use ONE of the following authentication methods:

# Option A: API key (simplest) — enable "Cloud Vision API" in your GCP project
GOOGLE_CLOUD_VISION_API_KEY=

# Option B: Service-account JSON file path (takes precedence if set)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Set to false to force the legacy Tesseract fallback
VISION_OCR_ENABLED=true

# ─── Ollama (optional, only used for AI grading; falls back to heuristics) ───
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3:mini-4k-instruct
OLLAMA_TIMEOUT_SECONDS=90

# ─── Server ───
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=5173
